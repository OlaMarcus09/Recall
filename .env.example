# Safe local defaults for Recall.
# Copy to .env for local development and replace values as needed.

RECALL_ENV=development
RECALL_DATABASE_PATH=data/recall.sqlite3
RECALL_UPLOAD_DIR=uploads
RECALL_EMBEDDING_PROVIDER=openai
RECALL_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=replace-with-your-openai-api-key
